# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Database (Dreamhost MySQL)
DB_HOST=mysql.yourdomain.com
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# JWT Authentication
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800
JWT_ALGORITHM=HS256

# Rate Limiting (file-based, suitable for shared hosting)
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID
CORS_MAX_AGE=86400

# SMTP Email (Dreamhost shared hosting — PHPMailer via SMTP)
# Ref: https://help.dreamhost.com/hc/en-us/articles/360031174411
# Host must be smtp.dreamhost.com (NOT mail.yourdomain.com — that is for GUI clients only)
# SMTP_USER and SMTP_FROM_EMAIL must be the same address on Dreamhost
SMTP_HOST=smtp.dreamhost.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_email_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME="Your App Name"

# hCaptcha (server-side verification for contact form)
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# Contact form recipient
CONTACT_TO_EMAIL=hello@yourdomain.com

# Logging
LOG_LEVEL=warning
LOG_PATH=logs/app.log
