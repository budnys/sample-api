# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Database (Dreamhost MySQL)
DB_HOST=mysql.yourdomain.com
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# JWT Authentication
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800
JWT_ALGORITHM=HS256

# Rate Limiting (file-based, suitable for shared hosting)
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID
CORS_MAX_AGE=86400

# SMTP Email (Dreamhost)
SMTP_HOST=mail.nomadtri.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=noreply@nomadtri.com
SMTP_PASS=your_email_password
SMTP_FROM_EMAIL=noreply@nomadtri.com
SMTP_FROM_NAME="NomadTri API"

# hCaptcha (server-side verification for contact form)
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# Contact form recipient
CONTACT_TO_EMAIL=hello@nomadtri.com

# Logging
LOG_LEVEL=warning
LOG_PATH=logs/app.log
